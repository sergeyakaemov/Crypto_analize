COINMARKETCAP_API_KEY=your_api_key_here

# Тип хранилища: json или sqlite
STORAGE=json

# Файл базы данных, используется при STORAGE=sqlite
DATABASE=crypto.db

POSTGRES_PASSWORD=

DJANGO_SECRET_KEY=

#Биржа: coingecko или coinmarketcap
EXCHANGE_PROVIDER=coingecko

# Celery: брокер и хранилище результатов
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
